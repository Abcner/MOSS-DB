{
    "SELECT": {
        "PROJECT": "REVENUE",
        "ORDERBY": "NONE",
        "FILTING": [
            {
                "TABLE": "DATE",
                "NAME": "D_YEAR",
                "EXPRESSION": "=",
                "VALUE": "1993"
            },
            {
                "TABLE": "LINEORDER",
                "NAME": "LO_DISCOUNT",
                "EXPRESSION": "BETWEENAND",
                "VALUE": [
                    1,
                    3
                ]
            },
            {
                "TABLE": "LINEORDER",
                "NAME": "LO_QUANTITY",
                "EXPRESSION": "<",
                "VALUE": "25"
            }
        ],
        "AGG": [
            {
                "FUNCTION": "SUM",
                "EXPRESSION": "LO_EXTENDEDPRICE*LO_DISCOUNT",
                "ALIAS": "REVENEU",
                "TABLE": "LINEORDER"
            }
        ]
    }
}