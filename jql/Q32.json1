[{
		"type":	"dimension",
		"parameters":	[{
				"from":	"customer",
				"where":	[{
						"op":	"=",
						"column":	"c_nation",
						"value":	"UNITED STATES"
					}],
				"group by":	"c_city"
			}, {
				"from":	"supplier",
				"where":	[{
						"op":	"=",
						"column":	"s_nation",
						"value":	"UNITED STATES"
					}],
				"group by":	"s_city"
			}, {
				"from":	"date",
				"where":	[{
						"op":	">=",
						"column":	"d_year",
						"value":	1992
					}, {
						"op":	"<=",
						"column":	"d_year",
						"value":	1997,
						"logic":	"AND"
					}],
				"group by":	"d_year"
			}]
	}, {
		"type":	"measure",
		"parameters":	{
			"from":	"lineorder",
			"FK_cols":	["lo_orderdate", "lo_custkey", "lo_suppkey"],
			"aggragate":	{
				"aggerate":	"sum",
				"agg_op":	"",
				"agg_cols":	["lo_revenue"],
				"agg_cols_type":	["column"]
			},
			"ProjectColumn":	["c_city", "s_city", "d_year", "revenue"]
		}
	}]
